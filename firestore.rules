rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() 
        && request.resource.data.keys().hasAll(['name', 'currentStage', 'version'])
        && request.resource.data.version is number;
      allow delete: if false;
    }

    match /dev_tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasAll(['projectId', 'status', 'retryCount'])
        && request.resource.data.retryCount <= 3;
      allow delete: if false;
    }

    match /agent_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['projectId', 'agentRole', 'tokensUsed']);
      allow update, delete: if false;
    }

    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
